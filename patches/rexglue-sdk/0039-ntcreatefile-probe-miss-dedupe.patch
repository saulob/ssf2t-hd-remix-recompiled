+// The guest probes the same missing loose files again and again; report each path's first miss only.
+static bool IsFirstMissReport(const std::string& path) {
+  static std::mutex mutex;
+  static std::unordered_set<std::string> reported;
+  std::lock_guard<std::mutex> lock(mutex);
+  return reported.insert(path).second;
+}
+
 u32 NtCreateFile_entry(mapped_u32 handle_out, u32 desired_access,
                        ppc_ptr_t<X_OBJECT_ATTRIBUTES> object_attrs,
                        ppc_ptr_t<X_IO_STATUS_BLOCK> io_status_block, mapped_u64 allocation_size_ptr,
@@ -169,7 +180,11 @@
 
   *handle_out = handle;
   if (XFAILED(result)) {
-    REXKRNL_IMPORT_FAIL("NtCreateFile", "path='{}' -> {:#x}", target_path, result);
+    if (result == X_STATUS_NO_SUCH_FILE && !IsFirstMissReport(target_path)) {
+      REXKRNL_IMPORT_TRACE("NtCreateFile", "repeated miss path='{}'", target_path);
+    } else {
+      REXKRNL_IMPORT_FAIL("NtCreateFile", "path='{}' -> {:#x}", target_path, result);
+    }
   } else {
     REXKRNL_IMPORT_RESULT("NtCreateFile", "{:#x} handle={:#x}", result, handle);
