+bool InputSystem::IsUserConnected(uint32_t user_index) {
+  std::lock_guard lock(mutex_);
+  if (!assignment_) {
+    return false;
+  }
+
+  RefreshDevices();
+  std::vector<DeviceId> ids;
+  assignment_->DevicesForUser(user_index, ids);
+  return std::any_of(ids.begin(), ids.end(), [&](DeviceId id) {
+    const DeviceInfo* info = DeviceInfoFor(id);
+    return info && (!info->synthetic || info->keyboard);
+  });
+}
+
+void InputSystem::LogAssignment() {
+  std::vector<DeviceId> ids;
+  for (uint32_t user = 0; user < kMaxGuestUsers; user++) {
+    assignment_->DevicesForUser(user, ids);
+    for (DeviceId id : ids) {
+      const DeviceInfo* info = DeviceInfoFor(id);
+      if (info && (!info->synthetic || info->keyboard)) {
+        REXLOG_INFO("Local input slot {}: {}", user, info->name);
+      }
+    }
+  }
+}
