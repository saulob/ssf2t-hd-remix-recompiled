+  driver->Add(1);
+  driver->SetButtons(1, X_INPUT_GAMEPAD_B);
+  REQUIRE(system->GetState(1, &state) == X_ERROR_SUCCESS);
+  REQUIRE(static_cast<uint16_t>(state.gamepad.buttons) == X_INPUT_GAMEPAD_B);
+  REQUIRE(system->GetState(0, &state) == X_ERROR_SUCCESS);
+  REQUIRE(static_cast<uint16_t>(state.gamepad.buttons) == X_INPUT_GAMEPAD_A);
+}
+
+TEST_CASE("The NOP stand-in alone never makes a guest user", "[input]") {
+  FakeDriver* driver = nullptr;
+  auto system = SlotSystem(&driver, true);
+  driver->Add(50, true);
+
+  REQUIRE(!system->IsUserConnected(0));
+  REQUIRE(!system->IsUserConnected(1));
+  X_INPUT_STATE state = {};
+  REQUIRE(system->GetState(0, &state) == X_ERROR_SUCCESS);
+}
