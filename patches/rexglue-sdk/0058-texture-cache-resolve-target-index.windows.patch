TextureCache::FindResolveCopyTargets scanned every cached texture on every resolve to find candidates
on the destination base page. Port of the known-good Geometry Wars Retro Evolved 2 Recompiled
(5f4c05c) and Hard Corps Uprising Recompiled (8d03c63) index: textures_by_base_page_, an
unordered_multimap<uint32_t, Texture*> keyed by TextureKey::base_page, lets the resolve look up only
the textures on the destination page via equal_range instead of iterating textures_ in full. All of
FindResolveCopyTargets's existing filters and 0022's resolve-copy-into-textures semantics are
unchanged; only how candidates are found is.

The index is kept in sync at every lifetime point: a new entry is added right after a texture is
inserted into textures_, removed (matched by pointer, since two textures can share a base page) when a
texture is destroyed, and cleared together with textures_ in DestroyAllTextures.

diff --git a/include/rex/graphics/pipeline/texture/cache.h b/include/rex/graphics/pipeline/texture/cache.h
--- a/include/rex/graphics/pipeline/texture/cache.h
+++ b/include/rex/graphics/pipeline/texture/cache.h
@@ -651,6 +651,8 @@
   uint64_t current_submission_time_ = 0;

   std::unordered_map<TextureKey, std::unique_ptr<Texture>, TextureKey::Hasher> textures_;
+  // textures_ by the page of their base level, for FindResolveCopyTargets (each resolve used to scan every texture).
+  std::unordered_multimap<uint32_t, Texture*> textures_by_base_page_;

   uint64_t textures_total_host_memory_usage_ = 0;

diff --git a/src/graphics/pipeline/texture/cache.cpp b/src/graphics/pipeline/texture/cache.cpp
--- a/src/graphics/pipeline/texture/cache.cpp
+++ b/src/graphics/pipeline/texture/cache.cpp
@@ -314,6 +314,13 @@
     assert_true(found_texture_it != textures_.end());
     if (found_texture_it != textures_.end()) {
       assert_true(found_texture_it->second.get() == texture);
+      auto [page_first, page_last] = textures_by_base_page_.equal_range(texture->key().base_page);
+      for (auto page_it = page_first; page_it != page_last; ++page_it) {
+        if (page_it->second == texture) {
+          textures_by_base_page_.erase(page_it);
+          break;
+        }
+      }
       textures_.erase(found_texture_it);
       // `texture` is invalid now.
     }
@@ -661,10 +668,13 @@
   }
   bool scaled = IsDrawResolutionScaled();
   uint32_t count = 0;
-  for (const auto& [key, texture_ptr] : textures_) {
+  auto [page_first, page_last] = textures_by_base_page_.equal_range(dest_page);
+  for (auto page_it = page_first; page_it != page_last; ++page_it) {
     if (count >= max_targets) {
       break;
     }
+    Texture* texture_ptr = page_it->second;
+    const TextureKey& key = texture_ptr->key();
     if (key.base_page != dest_page || key.format != copy.format ||
         key.endianness != copy.endian || !key.tiled ||
         key.dimension != xenos::DataDimension::k2DOrStacked || key.depth_or_array_size_minus_1 ||
@@ -857,6 +867,7 @@

 void TextureCache::DestroyAllTextures(bool from_destructor) {
   ResetTextureBindings(from_destructor);
+  textures_by_base_page_.clear();
   textures_.clear();
   COUNT_profile_set("gpu/texture_cache/textures", 0);
 }
@@ -974,6 +985,7 @@
     }
     assert_true(new_texture->key() == key);
     texture = textures_.emplace(key, std::move(new_texture)).first->second.get();
