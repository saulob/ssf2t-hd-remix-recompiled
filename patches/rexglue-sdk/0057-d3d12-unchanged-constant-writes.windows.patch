Skip derived-state invalidation when a GPU constant is rewritten with the value it already has, as in
the known-good Geometry Wars Retro Evolved 2 Recompiled (5f4c05c) and Hard Corps Uprising Recompiled
(8d03c63) commits. `gpu_skip_unchanged_constant_writes` (default on, hot-reloadable) gates it.

`StoreSwappedRegisters` stores the byte-swapped values the same way `memory::copy_and_swap` did and
reports whether any of them actually changed, so the two `WriteRegistersFromMem` range handlers that
touch float/bool/loop constants (0002/0050's bulk-register-range path is a different optimization, for
context/render-state registers, and is untouched here) and `WriteRegister` can skip marking the
constant buffer bindings, the fetch-constants generation and the texture cache's fetch-constant
tracking as stale when nothing changed.

Vertex-buffer residency is always invalidated on a fetch-constant write, changed or not: the guest may
have rewritten the vertex data at the same memory address, which this optimization must not hide.

diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -48,6 +48,11 @@
                     "Submit command list when PM4 primary buffer ends")
     .lifecycle(rex::cvar::Lifecycle::kHotReload);

+REXCVAR_DEFINE_BOOL(gpu_skip_unchanged_constant_writes, true, "GPU",
+                    "Keep the uploaded constant buffers, texture bindings and sampler state when the "
+                    "game rewrites float, bool, loop or fetch constants with the values they have")
+    .lifecycle(rex::cvar::Lifecycle::kHotReload);
+
 REXCVAR_DEFINE_BOOL(ssf2t_d3d12_sampler_memo, true, "GPU/D3D12",
                     "Recompute sampler parameters only when the shader, the fetch constants or "
                     "anisotropic_override changed")
@@ -88,6 +93,17 @@
   return uint64_t(process_mask) & ~uint64_t(0b11);
 }

+// Returns whether any stored value changed; branch-free so it vectorizes like memory::copy_and_swap.
+bool StoreSwappedRegisters(uint32_t* __restrict dest, const uint32_t* __restrict src, uint32_t count) {
+  uint32_t difference = 0;
+  for (uint32_t i = 0; i < count; ++i) {
+    uint32_t value = rex::byte_swap(src[i]);
+    difference |= dest[i] ^ value;
+    dest[i] = value;
+  }
+  return difference != 0;
+}
+
 }  // namespace

