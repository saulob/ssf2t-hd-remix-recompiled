+bool D3D12RenderTargetCache::MaterializeDeferredResolve(const DeferredResolve& resolve) {
+  auto& texture_cache = static_cast<D3D12TextureCache&>(deferred_resolve_texture_cache());
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+
+  DumpPipelineKey pipeline_key;
+  pipeline_key.msaa_samples = xenos::MsaaSamples::k1X;
+  pipeline_key.resource_format = resolve.source_key.resource_format;
+  pipeline_key.is_depth = false;
+  ID3D12PipelineState* pipeline = GetOrCreateDumpPipeline(pipeline_key);
+  if (!pipeline) {
+    return false;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[2];
+  if (!command_processor_.RequestOneUseSingleViewDescriptors(bindless_resources_used_ ? 1 : 2,
+                                                             descriptors)) {
+    return false;
+  }
+  // The format the render target's own dump source view has.
+  D3D12_SHADER_RESOURCE_VIEW_DESC srv_desc;
+  srv_desc.Format = GetColorOwnershipTransferDXGIFormat(resolve.source_key.GetColorFormat());
+  srv_desc.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+  srv_desc.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+  srv_desc.Texture2D.MostDetailedMip = 0;
+  srv_desc.Texture2D.MipLevels = 1;
+  srv_desc.Texture2D.PlaneSlice = 0;
+  srv_desc.Texture2D.ResourceMinLODClamp = 0.0f;
+  ID3D12Resource* texture_resource = texture_cache.UseTextureForComputeRead(resolve.texture);
+  device->CreateShaderResourceView(texture_resource, &srv_desc, descriptors[0].first);
+  D3D12_GPU_DESCRIPTOR_HANDLE descriptor_edram;
+  if (bindless_resources_used_) {
+    descriptor_edram = command_processor_.GetEdramUintPow2BindlessUAVHandlePair(2).second;
+  } else {
+    device->CopyDescriptorsSimple(
+        1, descriptors[1].first,
+        provider.OffsetViewDescriptor(edram_buffer_descriptor_heap_start_,
+                                      uint32_t(EdramBufferDescriptorIndex::kR32UintUAV)),
+        D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+    descriptor_edram = descriptors[1].second;
+  }
+
+  // The texture into the EDRAM tiles the resolve reads, as dumping its render target did. The
+  // resolve's fill takes the same pixels again, as the texture already has them filled.
+  TransitionEdramBuffer(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  command_processor_.SetExternalPipeline(pipeline);
+  command_list.D3DSetComputeRootSignature(dump_root_signature_color_);
+  command_list.D3DSetComputeRootDescriptorTable(kDumpRootParameterColorEdram, descriptor_edram);
+  command_list.D3DSetComputeRootDescriptorTable(kDumpRootParameterSource, descriptors[0].second);
+  DumpPitches pitches;
+  pitches.dest_pitch = resolve.dump_pitch;
+  pitches.source_pitch = resolve.source_key.GetPitchTiles();
+  command_list.D3DSetComputeRoot32BitConstants(kDumpRootParameterColorPitches,
+                                               sizeof(pitches) / sizeof(uint32_t), &pitches, 0);
+  ResolveCopyDumpRectangle rectangle(nullptr, 0, resolve.dump_rows, 0,
+                                     resolve.dump_row_length_used);
+  ResolveCopyDumpRectangle::Dispatch dispatches[ResolveCopyDumpRectangle::kMaxDispatches];
+  uint32_t dispatch_count =
+      rectangle.GetDispatches(resolve.dump_pitch, resolve.dump_row_length_used, dispatches);
+  DumpOffsets offsets;
+  offsets.source_base_tiles = resolve.source_key.base_tiles;
+  for (uint32_t i = 0; i < dispatch_count; ++i) {
+    const ResolveCopyDumpRectangle::Dispatch& dispatch = dispatches[i];
+    offsets.dispatch_first_tile = resolve.dump_base + dispatch.offset;
+    command_list.D3DSetComputeRoot32BitConstants(kDumpRootParameterOffsets,
+                                                 sizeof(offsets) / sizeof(uint32_t), &offsets, 0);
+    command_processor_.SubmitBarriers();
+    // 32bpp: a tile in two dispatches at 1x1 scale, as in DumpRenderTargets.
+    command_list.D3DDispatch((dispatch.width_tiles * draw_resolution_scale_x()) << 1,
+                             dispatch.height_tiles * draw_resolution_scale_y(), 1);
+    // Not the render target's contents anymore.
+    for (uint32_t row = 0; row < dispatch.height_tiles; ++row) {
+      SetEdramTilesDirty(resolve.dump_base + dispatch.offset + row * resolve.dump_pitch,
+                         dispatch.width_tiles, true);
+    }
+  }
+  MarkEdramBufferModified();
+
+  return DispatchResolveCopy(nullptr, texture_cache, resolve);
+}
