+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace rex::system::xam {
+
+inline constexpr size_t kLocalPlayerNameSlots = 4;
+inline constexpr size_t kMaxDisplayNameBytes = 15;
+
+inline std::string_view Utf8Prefix(std::string_view text, size_t max_bytes) {
+  if (text.size() <= max_bytes) {
+    return text;
+  }
+  size_t end = max_bytes;
+  while (end > 0 && (static_cast<unsigned char>(text[end]) & 0xC0) == 0x80) {
+    end--;
+  }
+  return text.substr(0, end);
+}
+
+// An empty configured name keeps the stock name.
+inline std::string LocalPlayerDisplayName(
+    uint32_t player_number, const std::array<std::string, kLocalPlayerNameSlots>& configured,
+    std::string_view stock) {
+  if (player_number >= 1 && player_number <= kLocalPlayerNameSlots) {
+    const std::string& name = configured[player_number - 1];
+    if (!name.empty()) {
+      return std::string(Utf8Prefix(name, kMaxDisplayNameBytes));
+    }
+  }
+  return std::string(stock);
+}
+
+}  // namespace rex::system::xam
