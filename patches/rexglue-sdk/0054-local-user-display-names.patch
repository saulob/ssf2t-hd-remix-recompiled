diff --git a/tests/unit/system/display_name_test.cpp b/tests/unit/system/display_name_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/unit/system/display_name_test.cpp
@@ -0,0 +1,50 @@
+#include <catch2/catch_test_macros.hpp>
+
+#include <rex/system/xam/display_name.h>
+#include <rex/system/xam/user_profile.h>
+
+using namespace rex::system::xam;
+
+namespace {
+
+using Names = std::array<std::string, kLocalPlayerNameSlots>;
+
+}  // namespace
+
+TEST_CASE("Profile identity does not depend on the display name", "[xam][user]") {
+  UserProfile profile;
+  const uint64_t xuid = profile.xuid();
+  const std::string profile_id = profile.profile_id();
+
+  const Names configured = {"Saulo", "Guest", "", ""};
+  REQUIRE(LocalPlayerDisplayName(1, configured, "Player 1") == "Saulo");
+
+  REQUIRE(profile.xuid() == xuid);
+  REQUIRE(profile.profile_id() == profile_id);
+  REQUIRE(profile_id == "User");
+
+  const Names defaults = {"", "", "", ""};
+  REQUIRE(LocalPlayerDisplayName(1, defaults, "Player 1") == "Player 1");
+  REQUIRE(profile.xuid() == xuid);
+  REQUIRE(profile.profile_id() == profile_id);
+}
+
+TEST_CASE("Configured names map to logical player numbers", "[xam][user]") {
+  const Names configured = {"One", "Two", "Three", "Four"};
+  REQUIRE(LocalPlayerDisplayName(1, configured, "x") == "One");
+  REQUIRE(LocalPlayerDisplayName(2, configured, "x") == "Two");
+  REQUIRE(LocalPlayerDisplayName(3, configured, "x") == "Three");
+  REQUIRE(LocalPlayerDisplayName(4, configured, "x") == "Four");
+  REQUIRE(LocalPlayerDisplayName(0, configured, "stock") == "stock");
+  REQUIRE(LocalPlayerDisplayName(5, configured, "stock") == "stock");
+}
+
+TEST_CASE("Display names never overflow the XAM buffer or split a character", "[xam][user]") {
+  const std::string long_name(40, 'A');
+  REQUIRE(Utf8Prefix(long_name, kMaxDisplayNameBytes).size() == kMaxDisplayNameBytes);
+
+  const std::string accents = "\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9";
+  const std::string_view cut = Utf8Prefix(accents, kMaxDisplayNameBytes);
+  REQUIRE(cut.size() == 14);
+  REQUIRE(Utf8Prefix("abc", kMaxDisplayNameBytes) == "abc");
+}
