diff --git a/src/file_dialog.cpp b/src/file_dialog.cpp
new file mode 100644
index 0000000..048aa26
--- /dev/null
+++ b/src/file_dialog.cpp
@@ -0,0 +1,108 @@
+#include "trg/file_dialog.h"
+
+#include <cstdlib>
+
+namespace trg::dialog {
+namespace {
+
+int HexValue(char c) {
+  if (c >= '0' && c <= '9') return c - '0';
+  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
+  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
+  return -1;
+}
+
+std::string VariantString(const std::string& s) {
+  std::string q = "'";
+  for (char c : s) {
+    if (c == '\'' || c == '\\') q += '\\';
+    q += c;
+  }
+  return q + "'";
+}
+
+std::vector<std::string> SplitPatterns(const std::string& patterns) {
+  std::vector<std::string> out;
+  std::string cur;
+  for (char c : patterns) {
+    if (c == ';' || c == ' ') {
+      if (!cur.empty()) out.push_back(cur);
+      cur.clear();
+    } else {
+      cur += c;
+    }
+  }
+  if (!cur.empty()) out.push_back(cur);
+  return out;
+}
+
+std::string FilterVariant(const std::string& name, const std::vector<std::string>& patterns) {
+  std::string v = "(" + VariantString(name) + ", [";
+  for (size_t i = 0; i < patterns.size(); ++i) v += (i ? ", (0, " : "(0, ") + VariantString(patterns[i]) + ")";
+  return v + "])";
+}
+
+}  // namespace
+
+std::string PathFromFileUri(const std::string& uri) {
+  static const std::string kScheme = "file://";
+  if (uri.compare(0, kScheme.size(), kScheme) != 0) return {};
+  size_t i = kScheme.size();
+  if (uri.compare(i, 10, "localhost/") == 0) i += 9;
+  if (i >= uri.size() || uri[i] != '/') return {};
+  std::string path;
+  for (; i < uri.size(); ++i) {
+    if (uri[i] != '%') {
+      path += uri[i];
+      continue;
+    }
+    const int hi = i + 2 < uri.size() ? HexValue(uri[i + 1]) : -1;
+    const int lo = hi >= 0 ? HexValue(uri[i + 2]) : -1;
+    if (lo < 0 || (hi == 0 && lo == 0)) return {};
+    path += char(hi * 16 + lo);
+    i += 2;
+  }
+  return path;
+}
+
+std::string PortalOptions(const std::string& handle_token, const std::vector<FileFilter>& filters, bool folder) {
+  std::string opts = "{'handle_token': <" + VariantString(handle_token) + ">, 'modal': <true>";
+  if (folder) {
+    opts += ", 'directory': <true>";
+  } else {
+    opts += ", 'filters': <[";
+    for (const FileFilter& f : filters) {
+      const auto patterns = SplitPatterns(f.patterns);
+      if (!patterns.empty()) opts += FilterVariant(f.name, patterns) + ", ";
+    }
+    opts += FilterVariant("All files", {"*"}) + "]>";
+  }
+  return opts + "}";
+}
+
+Result ParsePortalResponse(const std::string& line) {
+  static const std::string kMarker = "(uint32 ";
+  const size_t at = line.find(kMarker);
+  if (at == std::string::npos) return {};
+  const size_t code_at = at + kMarker.size();
+  const int code = std::atoi(line.c_str() + code_at);
+  if (code == 1) return {Outcome::kCancelled, {}};
+  if (code != 0) return {};
+
+  const size_t key = line.find("'uris'", code_at);
+  const size_t open = key == std::string::npos ? key : line.find('\'', key + 6);
+  const size_t close = open == std::string::npos ? open : line.find('\'', open + 1);
+  if (close == std::string::npos) return {};
+  const std::string path = PathFromFileUri(line.substr(open + 1, close - open - 1));
+  return path.empty() ? Result{} : Result{Outcome::kSelected, path};
+}
+
+Result RunBackends(const std::vector<std::function<Result()>>& backends) {
+  for (const auto& run : backends) {
+    const Result r = run();
+    if (r.outcome != Outcome::kUnavailable) return r;
+  }
+  return {};
+}
+
+}  // namespace trg::dialog
