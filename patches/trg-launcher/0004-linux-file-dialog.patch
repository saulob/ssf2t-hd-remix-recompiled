+// Backend-independent pieces of the Linux file dialogs: portal option and
+// reply handling, and the portal -> zenity -> kdialog fallback order.
+#pragma once
+
+#include <functional>
+#include <string>
+#include <vector>
+
+#include "trg/platform.h"
+
+namespace trg::dialog {
+
+enum class Outcome { kSelected, kCancelled, kUnavailable };
+
+struct Result {
+  Outcome outcome = Outcome::kUnavailable;
+  std::string path;
+};
+
+// "file:///a%20b" -> "/a b". Empty for other schemes, remote hosts or bad escapes.
+std::string PathFromFileUri(const std::string& uri);
+
+// GVariant text for the portal's OpenFile/options dictionary.
+std::string PortalOptions(const std::string& handle_token, const std::vector<FileFilter>& filters, bool folder);
+
+// Reads the Request.Response line printed by `gdbus monitor`.
+Result ParsePortalResponse(const std::string& line);
+
+// Tries each backend in order until one is available.
+Result RunBackends(const std::vector<std::function<Result()>>& backends);
+
+}  // namespace trg::dialog
