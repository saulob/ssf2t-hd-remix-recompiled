+// Exit 10: gdbus or stdbuf missing. Exit 11: the portal could not be reached.
+const char kPortalScript[] =
+    "command -v gdbus >/dev/null 2>&1 && command -v stdbuf >/dev/null 2>&1 || exit 10\n"
+    "out=$(mktemp) || exit 11\n"
+    "stdbuf -oL gdbus monitor --session --dest org.freedesktop.portal.Desktop >\"$out\" 2>/dev/null &\n"
+    "mon=$!\n"
+    "trap 'kill $mon 2>/dev/null; rm -f \"$out\"' EXIT\n"
+    "n=0\n"
+    "while [ ! -s \"$out\" ]; do\n"
+    "  kill -0 $mon 2>/dev/null && [ $n -lt 50 ] || exit 11\n"
+    "  n=$((n+1)); sleep 0.1\n"
+    "done\n"
+    "gdbus call --session --dest org.freedesktop.portal.Desktop --object-path /org/freedesktop/portal/desktop"
+    " --method org.freedesktop.portal.FileChooser.OpenFile '' \"$1\" \"$2\" >/dev/null 2>&1 || exit 11\n"
+    "while kill -0 $mon 2>/dev/null; do\n"
+    "  line=$(grep -m1 \"/$3: org.freedesktop.portal.Request.Response\" \"$out\") && { printf '%s\n' \"$line\"; exit 0; }\n"
+    "  sleep 0.2\n"
+    "done\n"
+    "exit 11\n";
+
+dialog::Result PortalDialog(const std::string& title, const std::vector<FileFilter>& filters, bool folder) {
+  static std::atomic<unsigned> counter{0};
+  const std::string token = "trg" + std::to_string(getpid()) + "_" + std::to_string(counter++);
+  const std::string cmd = "sh -c " + ShellQuote(kPortalScript) + " trg-portal " + ShellQuote(title) + " " +
+                          ShellQuote(dialog::PortalOptions(token, filters, folder)) + " " + ShellQuote(token);
+  FILE* p = popen(cmd.c_str(), "r");
+  if (!p) return {};
+  char buf[8192] = "";
+  const bool got = fgets(buf, sizeof buf, p) != nullptr;
+  const int status = pclose(p);
+  if (!got || !WIFEXITED(status) || WEXITSTATUS(status) != 0) return {};
+  return dialog::ParsePortalResponse(buf);
+}
+
+std::string Selected(const dialog::Result& r) {
+  g_dialog_unavailable = r.outcome == dialog::Outcome::kUnavailable;
+  return r.outcome == dialog::Outcome::kSelected ? r.path : std::string();
+}
 #endif
 
 }  // namespace
