diff --git a/include/trg/layout.h b/include/trg/layout.h
new file mode 100644
index 0000000..30e3d9b
--- /dev/null
+++ b/include/trg/layout.h
@@ -0,0 +1,117 @@
+// The launcher's metrics, with no dependency on Dear ImGui.
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <string_view>
+#include <vector>
+
+namespace trg {
+
+// ----------------------------------------------------------------- layout ---
+// Logical pixels: geometry is multiplied by Ui::scale(), and PushFont applies
+// the display scale to text sizes itself.
+namespace layout {
+inline constexpr float kTextBody = 15.0f;  // buttons, combos, sidebar, Fonts::size
+inline constexpr float kTextLabel = 16.0f;
+inline constexpr float kTextHelp = 14.0f;
+inline constexpr float kTextSection = 18.0f;
+inline constexpr float kTextPage = 28.0f;
+
+inline constexpr float kControlHeight = 34.0f;
+inline constexpr float kItemGap = 6.0f;
+inline constexpr float kRowPadding = 5.0f;  // above and below a row's content
+inline constexpr float kLabelGap = 1.0f;    // between a row's label and help text
+
+inline constexpr float kMargin = 14.0f;
+inline constexpr float kBodyGap = 6.0f;  // between the header and the panels
+inline constexpr float kContentPadding = 18.0f;
+inline constexpr float kContentTop = 12.0f;
+inline constexpr float kContentBottom = 6.0f;
+
+inline constexpr float kSidebarPadding = 8.0f;
+inline constexpr float kSidebarRow = 40.0f;
+inline constexpr float kSidebarIcon = 20.0f;
+inline constexpr float kSidebarIconInset = 11.0f;  // from the row's left edge
+inline constexpr float kSidebarIconGap = 11.0f;    // between the icon box and the label
+inline constexpr float kSidebarGap = 2.0f;
+
+inline constexpr float kFooterHeight = 60.0f;
+inline constexpr float kFooterButtonHeight = 36.0f;
+inline constexpr float kFooterButtonWidth = 108.0f;
+inline constexpr float kFooterGap = 10.0f;
+inline constexpr float kPlayWidth = 190.0f;
+inline constexpr float kPlayHeight = 42.0f;
+inline constexpr float kKeycapHeight = 26.0f;
+inline constexpr float kKeycapPadding = 8.0f;
+inline constexpr float kKeycapRounding = 6.0f;
+inline constexpr float kKeycapGap = 6.0f;     // between a keycap and its action
+inline constexpr float kKeyHintGap = 12.0f;   // between two shortcuts
+inline constexpr float kFooterSeparator = 28.0f;
+inline constexpr float kFooterSeparatorGap = 10.0f;
+inline constexpr float kFooterHelpLine = 18.0f;  // between the helper lines' centres
+
+inline float HeaderHeight(float viewport_height, float scale) {
+  return std::clamp(viewport_height * 0.145f, 88.0f * scale, 140.0f * scale);
+}
+
+inline float SidebarWidth(float viewport_width, float scale) {
+  return std::clamp(viewport_width * 0.15f, 168.0f * scale, 200.0f * scale);
+}
+
+inline float SidebarHeight(int pages) {
+  return kSidebarPadding * 2.0f + float(pages) * (kSidebarRow + kSidebarGap);
+}
+
+inline float ControlColumnWidth(float row_width, float scale) {
+  return std::clamp(row_width * 0.34f, 280.0f * scale, 360.0f * scale);
+}
+
+inline constexpr float SidebarLabelX() { return kSidebarIconInset + kSidebarIcon + kSidebarIconGap; }
+
+// Where to place a line so that the point `visual_center` below its top lands on `center`.
+inline float CenteredTop(float center, float visual_center) { return std::floor(center - visual_center + 0.5f); }
+
+struct KeyHint {
+  std::string_view key;  // empty when the text has no key
+  std::string_view action;
+};
+
+// "Enter  Play     Esc  Quit": two spaces inside a shortcut, more between shortcuts.
+inline std::vector<KeyHint> ParseKeyHints(std::string_view text) {
+  std::vector<KeyHint> hints;
+  while (!text.empty()) {
+    const size_t begin = text.find_first_not_of(' ');
+    if (begin == std::string_view::npos) break;
+    text.remove_prefix(begin);
+    const size_t end = text.find("   ");
+    std::string_view item = text.substr(0, end);
+    text.remove_prefix(item.size());
+    const size_t gap = item.find("  ");
+    if (gap == std::string_view::npos) {
+      hints.push_back({{}, item});
+    } else {
+      hints.push_back({item.substr(0, gap), item.substr(item.find_first_not_of(' ', gap))});
+    }
+  }
+  return hints;
+}
+
+// The footer's helper text, one sentence per line.
+inline std::vector<std::string_view> SplitSentences(std::string_view text) {
+  std::vector<std::string_view> lines;
+  while (!text.empty()) {
+    const size_t end = text.find(". ");
+    if (end == std::string_view::npos) {
+      lines.push_back(text);
+      break;
+    }
+    lines.push_back(text.substr(0, end + 1));
+    text.remove_prefix(end + 2);
+  }
+  return lines;
+}
+}  // namespace layout
+
+}  // namespace trg
diff --git a/include/trg/page_navigation.h b/include/trg/page_navigation.h
new file mode 100644
index 0000000..4d7e11e
--- /dev/null
+++ b/include/trg/page_navigation.h
@@ -0,0 +1,28 @@
+#pragma once
+
+namespace trg {
+
+// The page a frame draws. Requests made while a frame is being drawn wait for
+// Commit() at the start of the next one, so every part of a frame sees one page.
+class PageNavigation {
+ public:
+  PageNavigation() = default;
+  explicit PageNavigation(int page) : current_(page) {}
+
+  int current() const { return current_; }
+  void Request(int page) { pending_ = page; }
+
+  // True when a request was waiting, even for the current page.
+  bool Commit() {
+    if (pending_ < 0) return false;
+    current_ = pending_;
+    pending_ = -1;
+    return true;
+  }
+
+ private:
+  int current_ = 0;
+  int pending_ = -1;
+};
+
+}  // namespace trg
