+constexpr int kMaxRedirects = 5;
+
+bool IsRedirect(long code) {
+  return code == 301 || code == 302 || code == 303 || code == 307 || code == 308;
+}
+
+// An absolute, scheme-relative or root-relative Location against the address that sent it; "" otherwise.
+std::string ResolveLocation(const std::string& base, const std::string& location) {
+  if (location.rfind("https://", 0) == 0 || location.rfind("http://", 0) == 0) {
+    return location;
+  }
+  const size_t scheme_end = base.find("://");
+  if (scheme_end == std::string::npos) {
+    return {};
+  }
+  if (location.rfind("//", 0) == 0) {
+    return base.substr(0, scheme_end + 1) + location;
+  }
+  if (location.rfind('/', 0) == 0) {
+    const size_t path = base.find('/', scheme_end + 3);
+    return base.substr(0, path) + location;
+  }
+  return {};
+}
+
+// One request. With follow false a redirect is not taken: its Location is returned in `redirect`.
+std::string GetOnce(const std::string& url, std::string& out, Task* task, const HttpOptions& options, bool follow,
+                    std::string& redirect);
+
 }  // namespace
 
+std::string HttpGet(const std::string& url, std::string& out, Task* task, const HttpOptions& options) {
+  out.clear();
+  if (!ValidOptions(options)) {
+    return "The request headers are not valid.";
+  }
+  if (!options.allow_url) {
+    std::string unused;
+    return GetOnce(url, out, task, options, true, unused);
+  }
+  std::string current = url;
+  for (int hop = 0; hop <= kMaxRedirects; ++hop) {
+    if (!options.allow_url(current)) {
+      out.clear();
+      return "The download address is not allowed.";
+    }
+    std::string redirect;
+    std::string error = GetOnce(current, out, task, options, false, redirect);
+    if (!error.empty() || redirect.empty()) {
+      return error;
+    }
+    current = ResolveLocation(current, redirect);
+    if (current.empty()) {
+      out.clear();
+      return "The server sent an invalid redirect.";
+    }
+  }
+  out.clear();
+  return "The server redirected too many times.";
+}
